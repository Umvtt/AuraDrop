{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraDrop Setup",
  "mainBinaryName": "AuraDrop-Setup",
  "version": "0.2.0",
  "identifier": "com.umvtt.auradrop.setup",
  "build": {
    "beforeDevCommand": "npm run installer:vite",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run installer:vite-build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AuraDrop Setup",
        "width": 780,
        "height": 520,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
